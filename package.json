{
  "name": "astro-cloudfront-example",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint-fix": "pnpm -r --if-present --parallel /^.*-fix$/",
    "lint": "pnpm -r --if-present --parallel /^.*-check$/",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present --parallel test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "~11.24.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "download"
    }
  },
  "devDependencies": {}
}
